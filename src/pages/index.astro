---
import Layout from '../layouts/Layout.astro';
import { getBlogPosts, formatDate } from '../lib/contentful';

const posts = await getBlogPosts();
const latest = posts[0];
---

<Layout title="Website im Aufbau">
  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-100 to-white">
    <div class="container mx-auto px-4 py-24 lg:py-32">
      <div class="mx-auto max-w-3xl text-center">
        <span
          class="inline-block rounded-full bg-primary-500/10 px-4 py-1 text-sm font-medium text-primary-600"
        >
          Im Aufbau
        </span>
        <h1 class="mt-6 font-serif text-4xl font-bold text-gray-900 lg:text-6xl">
          Unsere neue Website entsteht gerade.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-700">
          {
            latest?.fields.excerpt ??
              'Wir arbeiten mit Hochdruck an unserem neuen Auftritt. Schauen Sie bald wieder vorbei – in der Zwischenzeit erreichen Sie uns jederzeit per E-Mail.'
          }
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          {
            latest && (
              <a
                href={`/blog/${latest.fields.slug}`}
                class="rounded bg-primary-500 px-6 py-3 font-medium text-white transition duration-150 ease-in-out hover:bg-primary-600"
              >
                Mehr erfahren
              </a>
            )
          }
          <a
            href="mailto:info@olymp.services"
            class="rounded border border-gray-300 px-6 py-3 font-medium text-gray-700 transition duration-150 ease-in-out hover:border-primary-500 hover:text-primary-500"
          >
            Kontakt aufnehmen
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Neuigkeiten -->
  {
    posts.length > 0 && (
      <section class="py-20">
        <div class="container mx-auto px-4">
          <h2 class="mb-10 text-center font-serif text-3xl font-bold text-gray-900">
            Neuigkeiten
          </h2>
          <div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-2">
            {posts.map((post) => (
              <a
                href={`/blog/${post.fields.slug}`}
                class="block rounded-lg border border-gray-200 p-6 transition duration-150 ease-in-out hover:border-primary-500 hover:shadow-md"
              >
                <p class="text-sm text-gray-500">
                  {formatDate(post.fields.publishDate)}
                </p>
                <h3 class="mt-2 font-serif text-xl font-bold text-gray-900">
                  {post.fields.title}
                </h3>
                {post.fields.excerpt && (
                  <p class="mt-3 text-gray-600">{post.fields.excerpt}</p>
                )}
                <span class="mt-4 inline-block text-sm font-medium text-primary-500">
                  Weiterlesen &rarr;
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
