---
import { formatDate, type BlogPostEntry } from '../../lib/contentful';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  post: BlogPostEntry;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const { title, slug, publishDate, excerpt, description } = post.fields;
const summary = description ?? excerpt;
const href = getLocalizedPath(lang, `/blog/${slug}`);
---

<a
  href={href}
  class="group block rounded-2xl border border-[var(--border)] bg-[var(--bg-secondary)] p-6 transition-all hover:-translate-y-0.5 hover:border-[var(--border-hover)] hover:shadow-lg"
>
  <p class="text-sm text-[var(--text-tertiary)]">{formatDate(publishDate, lang)}</p>
  <h3 class="mt-2 font-display text-xl font-bold text-[var(--text-primary)]">{title}</h3>
  {summary && <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">{summary}</p>}
  <span
    class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)]"
  >
    {t('blog.readMore')}
    <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
  </span>
</a>
