---
/**
 * ContactForm.astro — contact form, driven by Contentful.
 *
 * Two modes:
 *  - web3formsAccessKey set in Contentful  → POSTs to Web3Forms (static-site friendly).
 *  - no key (default)                      → builds a mailto: link on submit, so the
 *    visitor's own mail client sends the message. No data goes to any third party.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  accessKey?: string;
  recipientEmail: string;
}

const { accessKey, recipientEmail } = Astro.props;
const useWeb3Forms = Boolean(accessKey);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const inputClass =
  'block w-full rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] px-4 py-3 text-[var(--text-primary)] transition-colors focus:border-[var(--color-primary-500)] focus:ring-1 focus:ring-[var(--color-primary-500)] focus:outline-none';
---

<form
  id="contact-form"
  action={useWeb3Forms ? 'https://api.web3forms.com/submit' : undefined}
  method={useWeb3Forms ? 'POST' : undefined}
  data-mailto={useWeb3Forms ? undefined : recipientEmail}
  class="space-y-6"
>
  {useWeb3Forms && <input type="hidden" name="access_key" value={accessKey} />}
  <!-- Honeypot to prevent spam -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" />

  <div class="grid gap-6 sm:grid-cols-2">
    <div class="space-y-2">
      <label for="first-name" class="block text-sm font-medium text-[var(--text-primary)]">
        {t('contact.firstName')}
      </label>
      <input
        type="text"
        name="first-name"
        id="first-name"
        autocomplete="given-name"
        required
        class={inputClass}
      />
    </div>
    <div class="space-y-2">
      <label for="last-name" class="block text-sm font-medium text-[var(--text-primary)]">
        {t('contact.lastName')}
      </label>
      <input
        type="text"
        name="last-name"
        id="last-name"
        autocomplete="family-name"
        required
        class={inputClass}
      />
    </div>
  </div>

  <div class="space-y-2">
    <label for="email" class="block text-sm font-medium text-[var(--text-primary)]">
      {t('contact.email')}
    </label>
    <input type="email" name="email" id="email" autocomplete="email" required class={inputClass} />
  </div>

  <div class="space-y-2">
    <label for="message" class="block text-sm font-medium text-[var(--text-primary)]">
      {t('contact.message')}
    </label>
    <textarea id="message" name="message" rows="5" required class={inputClass}></textarea>
  </div>

  <button
    type="submit"
    class="w-full rounded-lg bg-[var(--color-primary-600)] px-6 py-3.5 text-center font-semibold text-white shadow-sm transition-all hover:-translate-y-0.5 hover:bg-[var(--color-primary-700)] hover:shadow-md active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary-600)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg)]"
  >
    {t('contact.submit')}
  </button>

  {
    !useWeb3Forms && (
      <p class="text-sm text-[var(--text-tertiary)]">{t('contact.mailtoNote')}</p>
    )
  }
</form>

<script>
  // Mailto fallback: without a Web3Forms key the form opens the visitor's
  // mail client with a prefilled message instead of posting anywhere.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const mailto = form?.dataset.mailto;
  if (form && mailto) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const firstName = String(data.get('first-name') ?? '');
      const lastName = String(data.get('last-name') ?? '');
      const email = String(data.get('email') ?? '');
      const message = String(data.get('message') ?? '');
      const subject = `Kontaktanfrage – ${firstName} ${lastName}`.trim();
      const body = `${message}\n\n—\n${firstName} ${lastName}\n${email}`;
      window.location.href = `mailto:${mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>
