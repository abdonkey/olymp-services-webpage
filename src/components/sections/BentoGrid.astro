---
/**
 * BentoGrid.astro — Feature/Service highlights grid (from astro-seo-theme).
 *
 * A CSS grid-based layout for highlighting key items. Items can span
 * columns/rows to create an asymmetric "bento box" look.
 */

interface BentoItem {
  title: string;
  description: string;
  icon?: string; // inline SVG string
  colSpan?: 1 | 2 | 3; // 3 = full row on desktop
  rowSpan?: 1 | 2;
}

interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  items: BentoItem[];
}

const { id = 'features', title, subtitle, items } = Astro.props;
---

<section id={id} class="py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl">
        {title}
      </h2>
      {subtitle && <p class="mt-4 text-lg text-[var(--text-secondary)]">{subtitle}</p>}
    </div>

    <div class="mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <div
          class:list={[
            'group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--bg)] p-8 transition-all duration-300 hover:border-[var(--color-primary-500)] hover:-translate-y-1 hover:shadow-lg hover:shadow-[var(--color-primary-500)]/5 dark:hover:shadow-[var(--color-primary-500)]/10',
            item.colSpan === 2 && 'sm:col-span-2 lg:col-span-2',
            item.colSpan === 3 && 'sm:col-span-2 lg:col-span-3',
            item.rowSpan === 2 && 'sm:row-span-2',
          ]}
        >
          <div class="relative z-10">
            {item.icon && (
              <div
                class="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-primary-50)] text-[var(--color-primary-500)] dark:bg-[var(--color-primary-500)]/10 dark:text-[var(--color-primary-400)]"
                set:html={item.icon}
              />
            )}
            <h3 class="text-xl font-semibold text-[var(--text-primary)]">{item.title}</h3>
            <p class="mt-3 text-[var(--text-secondary)] leading-relaxed">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
