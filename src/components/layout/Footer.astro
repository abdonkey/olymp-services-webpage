---
/**
 * Footer.astro — footer with sitemap navigation columns (SEO/GEO) and legal links.
 */
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

// Footer sitemap — mirrors the site structure for visitors and crawlers.
const footerColumns = [
  {
    title: t('nav.services'),
    links: [
      { label: t('nav.servicesItem'), href: getLocalizedPath(lang, '/#services') },
      { label: t('nav.caseStudies'), href: getLocalizedPath(lang, '/case-studies') },
    ],
  },
  {
    title: t('nav.resources'),
    links: [
      { label: t('nav.home'), href: getLocalizedPath(lang, '/') },
      { label: t('nav.about'), href: getLocalizedPath(lang, '/about') },
      { label: t('nav.blog'), href: getLocalizedPath(lang, '/blog') },
      { label: t('nav.contact'), href: getLocalizedPath(lang, '/contact') },
    ],
  },
  {
    title: t('footer.legal'),
    links: [
      { label: t('footer.imprint'), href: '/impressum' },
      { label: t('footer.privacy'), href: '/datenschutz' },
    ],
  },
];
---

<footer class="border-t border-[var(--border)] bg-[var(--bg)]">
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1">
        <a href={getLocalizedPath(lang, '/')} class="inline-block">
          <img
            src="/olymp-logo-full.jpg"
            alt="Olymp Services"
            width="1000"
            height="335"
            class="h-16 w-auto object-contain mix-blend-multiply dark:invert dark:mix-blend-screen"
            loading="lazy"
          />
        </a>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-[var(--text-secondary)]">
          {t('footer.tagline')}
        </p>
        <a
          href="mailto:info@olymp.services"
          class="mt-3 inline-block text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
        >
          info@olymp.services
        </a>
      </div>

      <!-- Sitemap columns -->
      <h2 class="sr-only">{t('footer.navigation')}</h2>
      {
        footerColumns.map((column) => (
          <nav aria-label={column.title}>
            <h3 class="text-sm font-semibold text-[var(--text-primary)]">{column.title}</h3>
            <ul class="mt-3 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-[var(--border)] pt-8 text-sm text-[var(--text-tertiary)] md:flex-row"
    >
      <p>&copy; {currentYear} Olymp Services. {t('footer.copyright')}</p>
      <a href="/sitemap-index.xml" class="transition-colors hover:text-[var(--text-primary)]">
        Sitemap
      </a>
    </div>
  </div>
</footer>
