---
// Minimal header while the site is under construction.
const navItems = [
  { label: 'Start', href: '/' },
  { label: 'Kontakt', href: 'mailto:info@olymp.services' },
];
---

<header class="border-b border-gray-100 bg-white">
  <div class="container mx-auto flex items-center justify-between px-4 py-4">
    <a href="/" class="flex items-center font-serif text-xl font-bold text-gray-900">
      <span
        class="mr-2 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-primary-500 font-sans text-white"
        aria-hidden="true"
      >
        O
      </span>
      Olymp&nbsp;Services
    </a>
    <nav class="flex items-center space-x-6 text-sm">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-gray-600 transition duration-150 ease-in-out hover:text-primary-500"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
