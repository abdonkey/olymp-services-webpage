---
const year = new Date().getFullYear();

const legalLinks = [
  { label: 'Impressum', href: '/impressum' },
  { label: 'Datenschutz', href: '/datenschutz' },
];
---

<footer class="bg-gray-900 text-white">
  <div class="container mx-auto px-4 py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="font-serif text-xl font-bold">Olymp Services</p>
        <p class="pt-2 text-sm text-gray-400">
          Unsere Website befindet sich derzeit im Aufbau.
        </p>
        <a
          href="mailto:info@olymp.services"
          class="mt-2 inline-block text-sm text-gray-300 hover:text-white"
        >
          info@olymp.services
        </a>
      </div>

      <nav aria-label="Rechtliches">
        <h2 class="mb-4 text-lg font-semibold">Rechtliches</h2>
        <ul class="space-y-2">
          {
            legalLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-gray-300 hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-8 border-t border-gray-700 pt-8">
      <p class="text-sm text-gray-400">
        &copy; {year} Olymp Services. Alle Rechte vorbehalten.
      </p>
    </div>
  </div>
</footer>
