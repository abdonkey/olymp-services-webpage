---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import JsonLd from '../seo/JsonLd.astro';
import PostCard from '../sections/PostCard.astro';
import { getBlogPosts } from '../../lib/contentful';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getBlogPosts();
const latest = posts[0];

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://olymp.services';
const pageTitle = lang === 'de' ? 'Website im Aufbau' : 'Under construction';
const primaryHref = latest
  ? getLocalizedPath(lang, `/blog/${latest.fields.slug}`)
  : getLocalizedPath(lang, '/blog');
---

<BaseLayout title={pageTitle} description={t('hero.description')}>
  <Fragment slot="head">
    <JsonLd
      type="Organization"
      data={{
        name: 'Olymp Services',
        url: siteUrl,
        logo: `${siteUrl}/favicon.svg`,
        description: t('hero.description'),
      }}
    />
    <JsonLd type="WebSite" data={{ name: 'Olymp Services', url: siteUrl }} />
  </Fragment>

  <Header slot="header" />

  <!-- Hero / under construction -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[var(--color-primary-100)]/40 to-transparent dark:from-[var(--color-primary-950)]/40"
    >
    </div>
    <div class="relative mx-auto max-w-4xl px-6 py-24 text-center lg:py-32">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-secondary)] px-4 py-1.5 text-sm font-medium text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)]"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-primary-500)] opacity-75"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-primary-600)]"></span>
        </span>
        {t('hero.badge')}
      </span>

      <h1
        class="mt-6 font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl lg:text-6xl"
      >
        {t('hero.title')}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[var(--text-secondary)]">
        {latest?.fields.excerpt ?? t('hero.description')}
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={primaryHref}
          class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-primary-600)] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-[var(--color-primary-600)]/25 transition-all hover:-translate-y-0.5 hover:bg-[var(--color-primary-700)]"
        >
          {t('hero.primaryCta')}
        </a>
        <a
          href={getLocalizedPath(lang, '/contact')}
          class="inline-flex items-center gap-2 rounded-xl border border-[var(--border)] px-6 py-3 text-sm font-semibold text-[var(--text-primary)] transition-colors hover:border-[var(--border-hover)] hover:bg-[var(--bg-secondary)]"
        >
          {t('hero.secondaryCta')}
        </a>
      </div>
    </div>
  </section>

  <!-- News -->
  {
    posts.length > 0 && (
      <section class="mx-auto max-w-5xl px-6 pb-24">
        <h2 class="mb-10 text-center font-display text-3xl font-bold text-[var(--text-primary)]">
          {t('blog.title')}
        </h2>
        <div class="grid gap-6 md:grid-cols-2">
          {posts.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </div>
      </section>
    )
  }

  <Footer slot="footer" />
</BaseLayout>
