---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import PostCard from '../sections/PostCard.astro';
import { getBlogPosts } from '../../lib/contentful';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await getBlogPosts();
---

<BaseLayout title={t('blog.title')} description={t('blog.description')}>
  <Header slot="header" />

  <section class="mx-auto max-w-5xl px-6 py-16 lg:py-20">
    <a
      href={getLocalizedPath(lang, '/')}
      class="text-sm font-medium text-[var(--color-primary-600)] hover:underline dark:text-[var(--color-primary-400)]"
    >
      &larr; {t('blog.backHome')}
    </a>
    <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)]">
      {t('blog.title')}
    </h1>
    <p class="mt-3 text-lg text-[var(--text-secondary)]">{t('blog.description')}</p>

    {
      posts.length > 0 ? (
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {posts.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </div>
      ) : (
        <p class="mt-10 text-[var(--text-secondary)]">{t('blog.empty')}</p>
      )
    }
  </section>

  <Footer slot="footer" />
</BaseLayout>
