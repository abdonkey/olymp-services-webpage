---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import JsonLd from '../seo/JsonLd.astro';
import ContactForm from '../sections/ContactForm.astro';
import { getContactPage } from '../../lib/contentful';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const page = await getContactPage();
const f = page?.fields;

const title = (lang === 'de' ? f?.titleDe : f?.titleEn) ?? t('nav.contact');
const intro = lang === 'de' ? f?.introDe : f?.introEn;
const email = f?.email ?? 'info@olymp.services';
const phone = f?.phone;
const headquarters = f?.headquarters;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://olymp.services';
---

<BaseLayout title={t('nav.contact')} description={intro ?? title}>
  <Fragment slot="head">
    <JsonLd
      type="Organization"
      data={{
        name: 'Olymp Services',
        url: siteUrl,
        logo: `${siteUrl}/favicon.svg`,
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'customer service',
          email,
          ...(phone && { telephone: phone }),
          availableLanguage: ['German', 'English'],
        },
      }}
    />
  </Fragment>

  <Header slot="header" />

  <main class="mx-auto max-w-7xl px-6 py-20 md:py-28">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      <!-- Contact info (left) -->
      <div>
        <h1
          class="font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl"
        >
          {title}
        </h1>
        {
          intro && (
            <p class="mt-6 text-lg leading-relaxed text-[var(--text-secondary)]">{intro}</p>
          )
        }

        <dl class="mt-12 space-y-8">
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wider text-[var(--text-primary)]">
              {t('contact.emailLabel')}
            </dt>
            <dd class="mt-2 text-lg text-[var(--text-secondary)]">
              <a
                href={`mailto:${email}`}
                class="transition-colors hover:text-[var(--color-primary-600)] dark:hover:text-[var(--color-primary-400)]"
              >
                {email}
              </a>
            </dd>
          </div>
          {
            phone && (
              <div>
                <dt class="text-sm font-semibold uppercase tracking-wider text-[var(--text-primary)]">
                  {t('contact.phoneLabel')}
                </dt>
                <dd class="mt-2 text-lg text-[var(--text-secondary)]">
                  <a
                    href={`tel:${phone.replace(/[^+\d]/g, '')}`}
                    class="transition-colors hover:text-[var(--color-primary-600)] dark:hover:text-[var(--color-primary-400)]"
                  >
                    {phone}
                  </a>
                </dd>
              </div>
            )
          }
          {
            headquarters && (
              <div>
                <dt class="text-sm font-semibold uppercase tracking-wider text-[var(--text-primary)]">
                  {t('contact.hqLabel')}
                </dt>
                <dd class="mt-2 whitespace-pre-line text-lg leading-relaxed text-[var(--text-secondary)]">
                  {headquarters}
                </dd>
              </div>
            )
          }
        </dl>
      </div>

      <!-- Contact form (right) -->
      <div class="rounded-3xl border border-[var(--border)] bg-[var(--bg)] p-8 shadow-sm sm:p-10">
        <h2 class="mb-8 font-display text-2xl font-bold text-[var(--text-primary)]">
          {t('contact.formTitle')}
        </h2>
        <ContactForm accessKey={f?.web3formsAccessKey} recipientEmail={email} />
      </div>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
