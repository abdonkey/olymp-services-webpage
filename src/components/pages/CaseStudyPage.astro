---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import JsonLd from '../seo/JsonLd.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import { assetUrl, type CaseStudyEntry } from '../../lib/contentful';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';

interface Props {
  caseStudy: CaseStudyEntry;
}

const { caseStudy } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, description, pubDate, updatedDate, client, industry, content } = caseStudy.fields;

const results = ((caseStudy.fields.results as any[]) ?? []).filter((r) => r?.fields);
const testimonial = (caseStudy.fields.testimonial as any)?.fields;
const testimonialAvatar = assetUrl(testimonial?.avatar?.fields?.file?.url);

const heroFile = (caseStudy.fields.heroImage as any)?.fields?.file;
const heroUrl = assetUrl(typeof heroFile?.url === 'string' ? heroFile.url : undefined);

const contentHtml = documentToHtmlString(content);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://olymp.services';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<BaseLayout title={title} description={description ?? title} image={heroUrl} ogType="article">
  <Fragment slot="head">
    <JsonLd
      type="BlogPosting"
      data={{
        headline: client ? `${client}: ${title}` : title,
        description: description ?? title,
        url: pageUrl,
        datePublished: new Date(pubDate).toISOString(),
        dateModified: updatedDate ? new Date(updatedDate).toISOString() : undefined,
        image: heroUrl,
        author: { name: 'Olymp Services' },
        publisher: { name: 'Olymp Services', logo: `${siteUrl}/olymp-mark.png` },
      }}
    />
  </Fragment>

  <Header slot="header" />

  <article class="mx-auto max-w-5xl px-6 py-12 md:py-20">
    <!-- Breadcrumbs -->
    <div class="mb-10 flex justify-center md:mb-16">
      <Breadcrumbs
        items={[
          { label: t('nav.home'), href: getLocalizedPath(lang, '/') },
          { label: t('caseStudies.title'), href: getLocalizedPath(lang, '/case-studies') },
          { label: client ?? title },
        ]}
      />
    </div>

    <!-- Header -->
    <header class="mb-16 text-center">
      <div class="mb-6 flex flex-wrap justify-center gap-3">
        {
          client && (
            <span class="rounded-full border border-[var(--border)] bg-[var(--bg-secondary)] px-4 py-1.5 text-sm font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
              {t('caseStudies.clientLabel')}: {client}
            </span>
          )
        }
        {
          industry && (
            <span class="rounded-full border border-[var(--border)] bg-[var(--bg-secondary)] px-4 py-1.5 text-sm font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
              {t('caseStudies.industryLabel')}: {industry}
            </span>
          )
        }
      </div>

      <h1 class="mx-auto max-w-4xl font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)] md:text-5xl lg:text-6xl">
        {title}
      </h1>

      {
        description && (
          <p class="mx-auto mt-6 max-w-2xl text-lg text-[var(--text-secondary)] md:text-xl">
            {description}
          </p>
        )
      }
    </header>

    {
      heroUrl && (
        <img
          src={heroUrl}
          alt={title}
          class="mb-16 w-full rounded-3xl border border-[var(--border)]"
          loading="lazy"
        />
      )
    }

    <!-- Key results -->
    {
      results.length > 0 && (
        <section class="mb-16 rounded-3xl border border-[var(--border)] bg-[var(--bg-secondary)]/50 p-8 md:p-12">
          <h2 class="sr-only">Key Results</h2>
          <div class="grid gap-8 divide-y divide-[var(--border)] sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            {results.slice(0, 3).map((result) => (
              <div class="flex flex-col items-center pt-8 text-center first:pt-0 sm:px-8 sm:pt-0 first:sm:pl-0 last:sm:pr-0">
                <p class="font-display text-4xl font-extrabold text-[var(--color-primary-600)] dark:text-[var(--color-primary-400)] md:text-5xl">
                  {result.fields.value}
                </p>
                <p class="mt-2 text-sm font-bold uppercase tracking-widest text-[var(--text-primary)]">
                  {result.fields.label}
                </p>
                {result.fields.description && (
                  <p class="mt-3 text-sm text-[var(--text-secondary)]">{result.fields.description}</p>
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Testimonial -->
    {
      testimonial && (
        <blockquote class="my-16 rounded-3xl bg-[var(--color-primary-900)] p-8 text-center sm:p-12">
          <svg class="mx-auto mb-6 h-10 w-10 text-[var(--color-primary-400)] opacity-50" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="font-display text-xl font-medium leading-relaxed text-white md:text-3xl">
            "{testimonial.quote}"
          </p>
          <footer class="mt-8">
            <div class="flex items-center justify-center gap-4">
              {testimonialAvatar && (
                <img
                  src={testimonialAvatar}
                  alt={testimonial.authorName}
                  width="48"
                  height="48"
                  class="h-12 w-12 rounded-full border-2 border-[var(--color-primary-400)]"
                />
              )}
              <div class="text-left">
                <p class="font-semibold text-white">{testimonial.authorName}</p>
                {testimonial.authorRole && (
                  <p class="text-sm text-[var(--color-primary-300)]">{testimonial.authorRole}</p>
                )}
              </div>
            </div>
          </footer>
        </blockquote>
      )
    }

    <!-- Main content -->
    <div
      class="prose prose-lg mx-auto prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-[var(--text-primary)] prose-a:text-[var(--color-primary-600)] dark:prose-a:text-[var(--color-primary-400)] hover:prose-a:text-[var(--color-primary-700)] dark:hover:prose-a:text-[var(--color-primary-300)] prose-img:rounded-xl prose-img:border prose-img:border-[var(--border)]"
      set:html={contentHtml}
    />

    <div class="mt-16 text-center">
      <a
        href={getLocalizedPath(lang, '/case-studies')}
        class="text-sm font-medium text-[var(--color-primary-600)] hover:underline dark:text-[var(--color-primary-400)]"
      >
        &larr; {t('caseStudies.backToList')}
      </a>
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>
